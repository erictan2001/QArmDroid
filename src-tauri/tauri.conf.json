{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QArmDroid",
  "version": "0.1.0",
  "identifier": "com.erict.qarmdroid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QArmDroid",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "resources": [
      "resources/qemu/**/*",
      "resources/image/**/*",
      "resources/tools/**/*",
      "resources/python/**/*",
      "resources/scrcpy/**/*",
      "resources/platform-tools/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}
