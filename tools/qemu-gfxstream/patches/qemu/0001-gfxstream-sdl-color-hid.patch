+static SDL_Cursor *sdl2_create_touch_cursor(int size, int active)
+{
+    int hot = size / 2;
+    float cx = (float)size / 2.0f;
+    float cy = (float)size / 2.0f;
+    float r_glow = (float)size / 2.0f;
+    float r_ring_outer = r_glow - 1.2f;
+    float r_ring_inner = r_ring_outer - 2.0f;
+
+    SDL_Surface *surf = SDL_CreateRGBSurfaceWithFormat(0, size, size, 32,
+                                                       SDL_PIXELFORMAT_ARGB8888);
+    if (!surf) {
+        return NULL;
+    }
+
+    uint32_t *pixels = (uint32_t *)surf->pixels;
+
+    for (int y = 0; y < size; y++) {
+        for (int x = 0; x < size; x++) {
+            float px = (float)x + 0.5f - cx;
+            float py = (float)y + 0.5f - cy;
+            float dist = hypotf(px, py);
+
+            if (dist >= r_glow) {
+                pixels[y * size + x] = 0;
+                continue;
+            }
+
+            float r = 0, g = 0, b = 0, a = 0;
+
+            if (dist > r_ring_outer) {
+                float t = (r_glow - dist) / (r_glow - r_ring_outer);
+                if (t < 0.0f) {
+                    t = 0.0f;
+                } else if (t > 1.0f) {
+                    t = 1.0f;
+                }
+                r = 59.0f;
+                g = 130.0f;
+                b = 246.0f;
+                a = (active ? 200.0f : 150.0f) * t * t;
+            } else if (dist >= r_ring_inner) {
+                r = 255.0f;
+                g = 255.0f;
+                b = 255.0f;
+                a = 245.0f;
+            } else {
+                float edge_dist = r_ring_inner - dist;
+                if (edge_dist < 0.8f) {
+                    float t = edge_dist / 0.8f;
+                    r = (1.0f - t) * 255.0f + t * 59.0f;
+                    g = (1.0f - t) * 255.0f + t * 130.0f;
+                    b = (1.0f - t) * 255.0f + t * 246.0f;
+                    a = (1.0f - t) * 245.0f + t * (active ? 180.0f : 140.0f);
+                } else {
+                    r = 59.0f;
+                    g = 130.0f;
+                    b = 246.0f;
+                    a = active ? 180.0f : 140.0f;
+                }
+            }
+
+            /* Windows DWM requires premultiplied alpha for color cursors */
+            float alpha_f = a / 255.0f;
+            uint32_t ur = (uint32_t)(r * alpha_f + 0.5f);
+            uint32_t ug = (uint32_t)(g * alpha_f + 0.5f);
+            uint32_t ub = (uint32_t)(b * alpha_f + 0.5f);
+            uint32_t ua = (uint32_t)(a + 0.5f);
+            if (ur > ua) { ur = ua; }
+            if (ug > ua) { ug = ua; }
+            if (ub > ua) { ub = ua; }
+
+            pixels[y * size + x] = (ua << 24) | (ur << 16) | (ug << 8) | ub;
+        }
+    }
+
+    SDL_Cursor *cursor = SDL_CreateColorCursor(surf, hot, hot);
+    SDL_FreeSurface(surf);
+    return cursor;
+}
