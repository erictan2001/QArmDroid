             buf[l++] = dy >> 8;
         }
         if (len > l) {
-            buf[l++] = dz;
+            /* ARM64: Tablet TipSwitch = left button. The HID descriptor
+             * maps this byte to BTN_TOUCH, so Android classes it as a
