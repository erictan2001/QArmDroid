+/*
+ * Letterbox calculation shared between mouse input mapping and GL viewport setup.
+ * Computes the on-screen render rectangle when a guest surface (surf_w x surf_h)
+ * is scaled to fit inside a window (win_w x win_h) while preserving aspect ratio.
+ *
+ * Outputs:
+ *   scale   - uniform scale factor (min of win_w/surf_w, win_h/surf_h)
+ *   render_w, render_h - on-screen size of the guest surface (rounded to nearest)
+ *   off_x, off_y - top-left offset of the render rect within the window (rounded)
+ *
+ * All outputs are integers suitable for pixel-accurate coordinate mapping.
+ * Uses round-to-nearest to match GL viewport integer truncation behavior.
+ */
+void sdl2_compute_letterbox(int win_w, int win_h,
+                            int surf_w, int surf_h,
+                            double *scale,
+                            int *render_w, int *render_h,
+                            int *off_x, int *off_y);
+
+/* For 2D renderer: use SDL's authoritative window->logical mapping directly */
+static inline void sdl2_window_to_logical(SDL_Renderer *renderer, int wx, int wy,
+                                          int *lx, int *ly)
+{
+    float fx = 0, fy = 0;
+    SDL_RenderWindowToLogical(renderer, wx, wy, &fx, &fy);
+    *lx = (int)fx;
+    *ly = (int)fy;
+}
