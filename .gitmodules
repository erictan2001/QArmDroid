[submodule "tools/qemu-gfxstream/qemu"]
	path = tools/qemu-gfxstream/qemu
	url = https://github.com/erictan2001/qemu.git
	branch = qarmdroid
	ignore = dirty
[submodule "tools/qemu-gfxstream/gfxstream"]
	path = tools/qemu-gfxstream/gfxstream
	url = https://github.com/erictan2001/gfxstream.git
	branch = qarmdroid
	ignore = dirty
[submodule "tools/qemu-gfxstream/rutabaga_gfx"]
	path = tools/qemu-gfxstream/rutabaga_gfx
	url = https://github.com/magma-gpu/rutabaga_gfx.git
	ignore = dirty
[submodule "tools/qemu-gfxstream/kernel-src/common"]
	path = tools/qemu-gfxstream/kernel-src/common
	url = https://android.googlesource.com/kernel/common
	ignore = all
